<section
  id="stats"
  class="relative bg-[var(--color-deep-brown)]/60 py-20 sm:py-28 noise-overlay"
  aria-label="Key statistics and achievements"
>
  <div class="mx-auto max-w-5xl px-6">

    <!-- Hard-edged label -->
    <div class="mb-12 inline-block -rotate-1 border-2 border-[var(--color-chalk-white)]/20 bg-[var(--color-steel-black)] px-6 py-2 font-space text-xs tracking-[0.3em] text-[var(--color-chalk-white)] uppercase">
      By the Numbers
    </div>

    <!-- Counter Grid -->
    <div class="grid grid-cols-2 gap-8 sm:gap-12 md:grid-cols-4">
      <div class="group reveal reveal-up">
        <div class="flex items-baseline gap-2">
          <span
            class="font-bebas text-5xl text-[var(--color-chalk-white)] sm:text-7xl tabular-nums"
            data-counter="47"
          >
            0
          </span>
          <span class="font-space text-xl text-[var(--color-ember-orange)]">+</span>
        </div>
        <p class="mt-2 font-space text-xs tracking-[0.15em] text-[var(--color-warm-gray)] uppercase">Projects</p>
        <div class="mt-2 h-[2px] w-8 bg-[var(--color-ember-orange)]"></div>
      </div>

      <div class="group reveal reveal-up">
        <div class="flex items-baseline gap-2">
          <span
            class="font-bebas text-5xl text-[var(--color-chalk-white)] sm:text-7xl tabular-nums"
            data-counter="6"
          >
            0
          </span>
          <span class="font-space text-xl text-[var(--color-red-blast)]">+</span>
        </div>
        <p class="mt-2 font-space text-xs tracking-[0.15em] text-[var(--color-warm-gray)] uppercase">Years</p>
        <div class="mt-2 h-[2px] w-8 bg-[var(--color-red-blast)]"></div>
      </div>

      <div class="group reveal reveal-up">
        <div class="flex items-baseline gap-2">
          <span
            class="font-bebas text-5xl text-[var(--color-chalk-white)] sm:text-7xl tabular-nums"
            data-counter="1200"
          >
            0
          </span>
          <span class="font-space text-xl text-[var(--color-burnt-crimson)]">+</span>
        </div>
        <p class="mt-2 font-space text-xs tracking-[0.15em] text-[var(--color-warm-gray)] uppercase">Photos</p>
        <div class="mt-2 h-[2px] w-8 bg-[var(--color-burnt-crimson)]"></div>
      </div>

      <div class="group reveal reveal-up">
        <div class="flex items-baseline gap-2">
          <span
            class="font-bebas text-5xl text-[var(--color-chalk-white)] sm:text-7xl tabular-nums"
            data-counter="83"
          >
            0
          </span>
          <span class="font-space text-xl text-[var(--color-chalk-white)]">+</span>
        </div>
        <p class="mt-2 font-space text-xs tracking-[0.15em] text-[var(--color-warm-gray)] uppercase">Videos</p>
        <div class="mt-2 h-[2px] w-8 bg-[var(--color-chalk-white)]"></div>
      </div>
    </div>
  </div>
</section>