---
import { Image } from 'astro:assets';
import invertocatSvg from '@assets/images/invertocat.svg';
---

<section
  id="contact"
  data-scroll-section="contact"
  class="relative bg-[var(--color-void-black)]/60 py-28 sm:py-36 overflow-hidden jsr-bg-halftone"
  aria-labelledby="contact-heading"
>
  <!-- Background Graphic -->
  <div class="absolute inset-0 jsr-bg-stripes opacity-10 pointer-events-none" aria-hidden="true"></div>

  <!-- Interactive Tactical Cursor Grid Spotlight Overlay -->
  <div
    id="contact-cursor-grid"
    class="absolute inset-0 pointer-events-none select-none z-10 transition-opacity duration-500 opacity-0"
    aria-hidden="true"
  >
    <!-- Tactical Grid Pattern masked around cursor -->
    <div
      class="w-full h-full"
      style="
        background-image: 
          linear-gradient(to right, rgba(214, 58, 28, 0.28) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(214, 58, 28, 0.28) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(circle 360px at var(--grid-mouse-x, 50%) var(--grid-mouse-y, 50%), rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 80%);
        -webkit-mask-image: radial-gradient(circle 360px at var(--grid-mouse-x, 50%) var(--grid-mouse-y, 50%), rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 80%);
      "
    ></div>

    <!-- Radial Glow Center Spotlight -->
    <div
      class="absolute w-[450px] h-[450px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none"
      style="
        left: var(--grid-mouse-x, 50%);
        top: var(--grid-mouse-y, 50%);
        background: radial-gradient(circle, rgba(214, 58, 28, 0.14) 0%, rgba(214, 58, 28, 0) 70%);
        will-change: left, top;
      "
    ></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 relative z-10">

    <!-- Section Header (Graphic layout) -->
    <div class="mb-20 flex items-baseline gap-4 relative">
      <h2 id="contact-heading" class="font-bebas text-6xl tracking-widest text-[var(--color-chalk-white)] sm:text-7xl text-shadow-hard italic transform -skew-x-6">
        Contact
      </h2>
      <div class="h-[2px] flex-1 bg-[var(--color-burnt-crimson)] ml-4"></div>
    </div>

    <!-- Two column layout (Typewriter / Cardboard Clipboard style) -->
    <div class="grid gap-16 md:grid-cols-2 items-start">

      <!-- Left Column: Graphic Details -->
      <div class="reveal reveal-left space-y-6">
        <h3 class="font-bebas text-3xl sm:text-4xl tracking-widest text-[var(--color-chalk-white)] transform -skew-x-6 italic">
          Get in Touch
        </h3>

        <!-- Graphic Label -->
        <div class="inline-block border-2 sm:border-4 border-[var(--color-red-blast)] px-4 sm:px-6 py-1.5 sm:py-2 font-bebas text-base sm:text-xl text-[var(--color-red-blast)] tracking-widest bg-[var(--color-void-black)] hover:bg-[var(--color-red-blast)] hover:text-[var(--color-void-black)] transition-colors max-w-full">
          OPEN FOR COMMISSIONS
        </div>

        <!-- System links list (Graphic Blocks) -->
        <div class="mt-8 space-y-4 font-mono text-xs font-bold">
          <a
            href="mailto:email@example.com"
            class="group flex items-center gap-4 bg-[var(--color-steel-black)] py-3 px-4 transition-all hover:bg-[var(--color-red-blast)] hover:text-[var(--color-void-black)]"
          >
            <span class="text-[var(--color-red-blast)] group-hover:text-[var(--color-void-black)] font-black text-xl">✉</span>
            <div class="overflow-hidden">
              <p class="text-[9px] text-[var(--color-warm-gray)] group-hover:text-[var(--color-void-black)] uppercase tracking-wider">EMAIL_ADDR</p>
              <p class="text-[var(--color-chalk-white)] group-hover:text-[var(--color-void-black)] truncate">aristyo2006@gmail.com</p>
            </div>
          </a>

          <a
            href="https://instagram.com/aristyo_2006/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 bg-[var(--color-steel-black)] py-3 px-4 transition-all hover:bg-[var(--color-burnt-crimson)] hover:text-[var(--color-void-black)]"
          >
            <div class="w-5 h-5 flex items-center justify-center text-[var(--color-burnt-crimson)] group-hover:text-[var(--color-void-black)] transition-colors">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 32 32">
                <path d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z"/>
                <path d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8   c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z"/>
                <path d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8   c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z"/>
              </svg>
            </div>
            <div class="overflow-hidden">
              <p class="text-[9px] text-[var(--color-warm-gray)] group-hover:text-[var(--color-void-black)] uppercase tracking-wider">INSTAGRAM</p>
              <p class="text-[var(--color-chalk-white)] group-hover:text-[var(--color-void-black)] truncate">@aristyo_2006</p>
            </div>
          </a>

          <a
            href="https://github.com/Aristyo2006"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 bg-[var(--color-steel-black)] py-3 px-4 transition-all hover:bg-[var(--color-chalk-white)] hover:text-[var(--color-void-black)]"
          >
            <div class="w-5 h-5 flex items-center justify-center">
              <Image src={invertocatSvg} alt="GitHub" class="w-5 h-5 object-contain" />
            </div>
            <div class="overflow-hidden">
              <p class="text-[9px] text-[var(--color-warm-gray)] group-hover:text-[var(--color-void-black)] uppercase tracking-wider">GITHUB</p>
              <p class="text-[var(--color-chalk-white)] group-hover:text-[var(--color-void-black)] truncate">@Aristyo2006</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Right Column: Clean Editorial Form -->
      <div class="reveal reveal-right relative pb-4">
        
        <!-- Main Form Container -->
        <div class="relative bg-[var(--color-void-black)] p-4 sm:p-10 border-2 border-[var(--color-chalk-white)] font-mono text-xs z-20 jsr-bg-stripes">
          
          <form class="space-y-6 sm:space-y-8 relative bg-[var(--color-void-black)] p-4 sm:p-8 border-2 border-[var(--color-steel-black)]" id="contact-form">
            <!-- Web3Forms Config -->
            <input type="hidden" name="access_key" value="2971275c-8726-4c94-9a2a-69e953b9a134" />
            <input type="hidden" name="subject" value="New Portfolio Inquiry from Portofolio Web" />
            <input type="hidden" name="from_name" value="Web Portfolio" />

            <h3 class="font-bebas text-4xl tracking-widest text-[var(--color-chalk-white)] text-center border-b-2 border-[var(--color-steel-black)] pb-4">
              SUBMIT QUESTIONNAIRE
            </h3>

            <div>
              <label for="contact-name" class="block text-[10px] font-bold tracking-wider text-[var(--color-chalk-white)] uppercase mb-2 bg-[var(--color-burnt-crimson)] inline-block px-2 py-0.5">// 01_NAME</label>
              <div class="relative mt-2">
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  class="relative w-full bg-[var(--color-steel-black)] border-b-2 border-transparent px-4 py-3 text-sm text-[var(--color-chalk-white)] font-bold outline-none focus:border-[var(--color-red-blast)] font-mono z-10 transition-colors"
                  placeholder="INPUT NAME"
                  aria-required="true"
                />
              </div>
            </div>

            <div>
              <label for="contact-email" class="block text-[10px] font-bold tracking-wider text-[var(--color-chalk-white)] uppercase mb-2 bg-[var(--color-ember-orange)] text-[var(--color-void-black)] inline-block px-2 py-0.5">// 02_EMAIL</label>
              <div class="relative mt-2">
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  class="relative w-full bg-[var(--color-steel-black)] border-b-2 border-transparent px-4 py-3 text-sm text-[var(--color-chalk-white)] font-bold outline-none focus:border-[var(--color-ember-orange)] font-mono z-10 transition-colors"
                  placeholder="INPUT EMAIL"
                  aria-required="true"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-[10px] font-bold tracking-wider text-[var(--color-chalk-white)] uppercase mb-2 bg-[var(--color-red-blast)] inline-block px-2 py-0.5">// 03_ENQUIRY</label>
              <div class="relative mt-2">
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  required
                  class="relative w-full bg-[var(--color-steel-black)] border-b-2 border-transparent px-4 py-3 text-sm text-[var(--color-chalk-white)] font-bold resize-none outline-none focus:border-[var(--color-red-blast)] font-mono z-10 transition-colors"
                  placeholder="INPUT DESCRIPTION OF PROJECT"
                  aria-required="true"
                ></textarea>
              </div>
            </div>

            <!-- Submit button -->
            <div class="relative group mt-8 flex justify-end">
              <button
                type="submit"
                class="relative inline-block border-2 border-[var(--color-chalk-white)] bg-[var(--color-red-blast)] px-10 py-4 font-space text-[14px] font-black uppercase tracking-widest text-[var(--color-void-black)] transition-all hover:bg-[var(--color-chalk-white)] z-10"
              >
                TRANSMIT // →
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const w = window as any;
  if (w.__contactFormCleanup) {
    w.__contactFormCleanup();
  }
  if (w.__contactFormPageLoadHandler) {
    document.removeEventListener('astro:page-load', w.__contactFormPageLoadHandler);
  }

  function initContactForm() {
    if (w.__contactFormCleanup) {
      w.__contactFormCleanup();
    }

    const section = document.getElementById('contact');
    const gridContainer = document.getElementById('contact-cursor-grid');
    const form = document.getElementById('contact-form') as HTMLFormElement | null;

    const abortController = new AbortController();
    const signal = abortController.signal;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const originalText = submitBtn ? submitBtn.innerHTML : '';

        if (submitBtn) {
          submitBtn.innerHTML = 'TRANSMITTING... // ⏳';
          submitBtn.disabled = true;
        }

        const formData = new FormData(form);

        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData,
          });

          const data = await response.json();

          if (data.success) {
            if (submitBtn) {
              submitBtn.innerHTML = 'TRANSMISSION SUCCESSFUL // ✓';
            }
            form.reset();
            setTimeout(() => {
              if (submitBtn) {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
              }
            }, 4000);
          } else {
            throw new Error(data.message || 'Submission failed');
          }
        } catch (err) {
          // Fallback: Open Gmail Web Compose window
          const name = (formData.get('name') as string) || 'Anonymous';
          const email = (formData.get('email') as string) || 'Not provided';
          const message = (formData.get('message') as string) || '';

          const subject = encodeURIComponent(`Portfolio Inquiry from ${name}`);
          const body = encodeURIComponent(`NAME: ${name}\nEMAIL: ${email}\n\nENQUIRY:\n${message}`);

          const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=aristyo2006@gmail.com&su=${subject}&body=${body}`;
          const mailtoUrl = `mailto:aristyo2006@gmail.com?subject=${subject}&body=${body}`;

          const newTab = window.open(gmailUrl, '_blank');
          if (!newTab || newTab.closed || typeof newTab.closed === 'undefined') {
            window.location.href = mailtoUrl;
          }

          if (submitBtn) {
            submitBtn.innerHTML = 'TRANSMISSION INITIATED // ✓';
            setTimeout(() => {
              submitBtn.innerHTML = originalText;
              submitBtn.disabled = false;
              form.reset();
            }, 3000);
          }
        }
      }, { signal });
    }

    let rafId = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let isMouseOver = false;

    if (section && gridContainer) {
      function updateGridPosition() {
        if (!gridContainer) return;
        currentX += (targetX - currentX) * 0.18;
        currentY += (targetY - currentY) * 0.18;

        gridContainer.style.setProperty('--grid-mouse-x', `${currentX}px`);
        gridContainer.style.setProperty('--grid-mouse-y', `${currentY}px`);

        if (isMouseOver || Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
          rafId = requestAnimationFrame(updateGridPosition);
        } else {
          rafId = 0;
        }
      }

      section.addEventListener('mousemove', (e) => {
        const rect = section.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;

        if (!isMouseOver) {
          isMouseOver = true;
          gridContainer.classList.remove('opacity-0');
          gridContainer.classList.add('opacity-100');
          currentX = targetX;
          currentY = targetY;
        }

        if (!rafId) {
          rafId = requestAnimationFrame(updateGridPosition);
        }
      }, { passive: true, signal });

      section.addEventListener('mouseleave', () => {
        isMouseOver = false;
        gridContainer.classList.remove('opacity-100');
        gridContainer.classList.add('opacity-0');
      }, { signal });
    }

    w.__contactFormCleanup = () => {
      abortController.abort();
      if (rafId) cancelAnimationFrame(rafId);
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true });
  } else {
    initContactForm();
  }
  w.__contactFormPageLoadHandler = initContactForm;
  document.addEventListener('astro:page-load', w.__contactFormPageLoadHandler);
</script>