---
import { Image } from 'astro:assets';
import heroImg from '@assets/images/_DSC8723.jpg';
---

<section
  id="hero"
  data-scroll-section="hero"
  class="relative z-10 flex min-h-screen items-center justify-center overflow-hidden bg-[var(--color-steel-black)]"
  aria-labelledby="hero-heading"
>
  <!-- Full-bleed Hero Background Image Container -->
  <div
    id="hero-bg-wrapper"
    class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden will-change-transform"
    aria-hidden="true"
  >
    <Image
      src={heroImg}
      alt="Hero Background"
      width={1920}
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-center opacity-70 filter brightness-90 contrast-105"
    />
    <!-- Gradient overlays: dark on left behind text, and smooth fade out at bottom -->
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-steel-black)] via-[var(--color-steel-black)]/80 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-[var(--color-steel-black)] z-10"></div>
    <div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-[var(--color-steel-black)] via-[var(--color-steel-black)]/70 to-transparent z-10"></div>
  </div>

  <!-- Interactive Tactical Cursor Grid Spotlight Overlay -->
  <div
    id="hero-cursor-grid"
    class="absolute inset-0 pointer-events-none select-none z-10 transition-opacity duration-500 opacity-0"
    aria-hidden="true"
  >
    <!-- Tactical Grid Pattern masked around cursor -->
    <div
      class="w-full h-full"
      style="
        background-image: 
          linear-gradient(to right, rgba(214, 58, 28, 0.28) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(214, 58, 28, 0.28) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(circle 360px at var(--grid-mouse-x, 50%) var(--grid-mouse-y, 50%), rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 80%);
        -webkit-mask-image: radial-gradient(circle 360px at var(--grid-mouse-x, 50%) var(--grid-mouse-y, 50%), rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 80%);
      "
    ></div>

    <!-- Radial Glow Center Spotlight -->
    <div
      class="absolute w-[450px] h-[450px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none"
      style="
        left: var(--grid-mouse-x, 50%);
        top: var(--grid-mouse-y, 50%);
        background: radial-gradient(circle, rgba(214, 58, 28, 0.14) 0%, rgba(214, 58, 28, 0) 70%);
        will-change: left, top;
      "
    ></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-28 md:py-36">
    <!-- Main grid layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Title & Metadata -->
      <div class="lg:col-span-12 flex flex-col items-start gap-4">
        <div class="relative mt-2 z-10">
          <!-- Giant title split blocks -->
          <h1 id="hero-heading" class="font-bebas text-7xl sm:text-8xl md:text-[10rem] leading-[0.8] tracking-tighter text-[var(--color-chalk-white)] uppercase select-none italic transform -skew-x-6">
            <!-- Block 1: HELLO, I'm -->
            <span class="block text-shadow-hard transform hover-snap" data-scramble="HELLO, I'M">HELLO, I'M</span>
            <!-- Block 2: NAME -->
            <span class="block text-[var(--color-red-blast)] pl-12 sm:pl-20 mt-2 select-text font-black tracking-tight transform hover-snap-reverse text-shadow-hard relative" data-scramble="ARISTYO">
              ARISTYO 
              <!-- Dynamic overlap element -->
              <span class="absolute -bottom-4 right-0 text-3xl font-space text-[var(--color-chalk-white)] bg-[var(--color-void-black)] px-4 py-1 clip-parallelogram-reverse border-2 border-[var(--color-red-blast)] transform rotate-[-5deg]">#01</span>
            </span>
            <!-- Block 3: HERE -->
            <span class="block text-[var(--color-chalk-white)] pl-4 mt-2 text-outline-bold transform hover-snap" data-scramble="RAHARDIYAN">RAHARDIYAN</span>
          </h1>
        </div>

        <!-- Tagline / Skills overview -->
        <div class="mt-6 pl-4 border-l-4 border-[var(--color-red-blast)] transform skew-x-12 bg-[var(--color-void-black)]/80 backdrop-blur-sm p-4 clip-diagonal-cut">
          <p class="max-w-xl font-space text-sm font-bold tracking-widest text-[var(--color-chalk-white)] uppercase leading-relaxed transform -skew-x-12">
            Photographer // Videographer // Designer // Programmer // Hardware Engineer
          </p>
        </div>

        <!-- Navigation / Action Buttons -->
        <div class="flex flex-wrap gap-4 mt-8 pl-4">
          <!-- Button 1: View Projects -->
          <div class="rotate-[-1.5deg] hover-snap">
            <a
              href="#projects"
              data-magnetic="0.2"
              class="magnetic relative block bg-[var(--color-red-blast)] px-10 py-4 font-space text-sm font-black uppercase tracking-[0.2em] text-[var(--color-chalk-white)] transition-all hover:bg-[var(--color-chalk-white)] hover:text-[var(--color-void-black)] clip-parallelogram"
            >
              <span class="inline-block">View Projects</span>
            </a>
          </div>

          <!-- Button 2: Contact -->
          <div class="rotate-[1.5deg] hover-snap-reverse">
            <a
              href="#contact"
              data-magnetic="0.2"
              class="magnetic relative block bg-[var(--color-void-black)] border-2 border-[var(--color-chalk-white)] px-10 py-3 font-space text-sm font-black uppercase tracking-[0.2em] text-[var(--color-chalk-white)] transition-all hover:bg-[var(--color-chalk-white)] hover:text-[var(--color-void-black)] clip-parallelogram-reverse"
            >
              Contact
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll Shutter Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 select-none z-10">
    <span class="font-mono text-[8px] tracking-[0.4em] text-[var(--color-warm-gray)] uppercase">SHUTTER DOWN</span>
    <div class="h-8 w-[1px] bg-[var(--color-warm-gray)] animate-pulse"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const w = window as any;
  if (w.__heroGridCleanup) {
    w.__heroGridCleanup();
  }
  if (w.__heroGridPageLoadHandler) {
    document.removeEventListener('astro:page-load', w.__heroGridPageLoadHandler);
  }

  function initHeroCursorGrid() {
    if (w.__heroGridCleanup) {
      w.__heroGridCleanup();
    }

    const hero = document.getElementById('hero');
    const gridContainer = document.getElementById('hero-cursor-grid');
    const bgWrapper = document.getElementById('hero-bg-wrapper');
    if (!hero || !gridContainer) return;

    const abortController = new AbortController();
    const signal = abortController.signal;

    let rafId = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let isMouseOver = false;

    // Scroll-driven GSAP Parallax & Fade for Hero background photo
    let scrollTween: gsap.core.Tween | null = null;
    const heroImgEl = bgWrapper?.querySelector('img');
    if (heroImgEl) {
      scrollTween = gsap.to(heroImgEl, {
        yPercent: 20,
        opacity: 0.1,
        ease: 'none',
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }

    // One-time GSAP Cyber Text Scramble Decoder for Hero Title
    if (!w.__heroHasScrambled) {
      w.__heroHasScrambled = true;

      const scrambleElements = hero.querySelectorAll('[data-scramble]');
      const cyberChars = '!@#$%^&*()_+-=[]{}|;:,.<>?/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';

      scrambleElements.forEach((el, elIdx) => {
        const targetText = el.getAttribute('data-scramble') || '';
        if (!targetText) return;

        let frame = 0;
        const totalFrames = targetText.length * 3 + 8;
        const delayMs = elIdx * 200 + 150;

        setTimeout(() => {
          const timer = setInterval(() => {
            const currentText = targetText
              .split('')
              .map((char, charIdx) => {
                if (char === ' ' || char === "'") return char;
                if (charIdx < Math.floor(frame / 3)) return targetText[charIdx];
                return cyberChars[Math.floor(Math.random() * cyberChars.length)];
              })
              .join('');

            // Preserve child elements (such as badge #01)
            if (el.childNodes.length > 0 && el.childNodes[0].nodeType === Node.TEXT_NODE) {
              el.childNodes[0].nodeValue = currentText + ' ';
            } else {
              el.textContent = currentText;
            }

            if (frame >= totalFrames) {
              if (el.childNodes.length > 0 && el.childNodes[0].nodeType === Node.TEXT_NODE) {
                el.childNodes[0].nodeValue = targetText + ' ';
              }
              clearInterval(timer);
            }
            frame++;
          }, 35);
        }, delayMs);
      });
    }

    function updateGridPosition() {
      currentX += (targetX - currentX) * 0.18;
      currentY += (targetY - currentY) * 0.18;

      gridContainer.style.setProperty('--grid-mouse-x', `${currentX}px`);
      gridContainer.style.setProperty('--grid-mouse-y', `${currentY}px`);

      if (isMouseOver || Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
        rafId = requestAnimationFrame(updateGridPosition);
      } else {
        rafId = 0;
      }
    }

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;

      if (!isMouseOver) {
        isMouseOver = true;
        gridContainer.classList.remove('opacity-0');
        gridContainer.classList.add('opacity-100');
        currentX = targetX;
        currentY = targetY;
      }

      if (!rafId) {
        rafId = requestAnimationFrame(updateGridPosition);
      }
    }, { passive: true, signal });

    hero.addEventListener('mouseleave', () => {
      isMouseOver = false;
      gridContainer.classList.remove('opacity-100');
      gridContainer.classList.add('opacity-0');
    }, { signal });

    w.__heroGridCleanup = () => {
      abortController.abort();
      if (rafId) cancelAnimationFrame(rafId);
      if (scrollTween) {
        if (scrollTween.scrollTrigger) scrollTween.scrollTrigger.kill();
        scrollTween.kill();
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCursorGrid, { once: true });
  } else {
    initHeroCursorGrid();
  }
  w.__heroGridPageLoadHandler = initHeroCursorGrid;
  document.addEventListener('astro:page-load', w.__heroGridPageLoadHandler);
</script>