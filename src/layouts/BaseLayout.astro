---
import '@/styles/global.css';
import Scripts from '@/utils/scripts.astro';
import BackgroundProceduralArrows from '@/components/graphics/BackgroundProceduralArrows.astro';
import IndustrialLocatorCursor from '@/components/IndustrialLocatorCursor.astro';
import FullpageSnap from '@/components/FullpageSnap.astro';
import SmoothScroll from '@/components/SmoothScroll.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090909" />
    <meta name="color-scheme" content="dark only" />

    <title>{title ?? 'Portfolio — Photographer · Videographer · Designer · Programmer · Hardware Engineer'}</title>
    <meta
      name="description"
      content={description ?? 'Underground creative portfolio. Photography, videography, design, programming, and audio work.'}
    />

    <meta property="og:title" content={title ?? 'Portfolio'} />
    <meta property="og:description" content={description ?? 'Underground creative portfolio'} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image ?? '/og-image.png'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? 'Portfolio'} />
    <meta name="twitter:description" content={description ?? 'Underground creative portfolio'} />

    <link rel="icon" href="/logo2_w.png" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:opsz,wght@14..32,300..700&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="relative min-h-screen bg-[var(--color-void-black)] jsr-bg-halftone text-[var(--color-chalk-white)] selection:bg-[var(--color-burnt-crimson)] selection:text-[var(--color-chalk-white)]">


    <!-- JSR Directional Overlay -->
    <div class="pointer-events-none fixed inset-0 z-[9998] jsr-bg-stripes opacity-40 mix-blend-overlay" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-[9999] scanlines-overlay opacity-30" aria-hidden="true"></div>

    <!-- Reading Progress Bar (Snappy, jagged) -->
    <div
      id="reading-progress-bar"
      class="fixed top-0 left-0 h-[4px] bg-[var(--color-red-blast)] z-[9999] w-full origin-left scale-x-0 transition-transform duration-75 ease-out clip-slash"
      role="progressbar"
      aria-label="Page scroll progress"
    ></div>

    <!-- Simple Minimal Progress Bar Loader -->
    <div
      id="global-loader"
      class="loader-overlay flex flex-col items-center justify-center bg-[var(--color-void-black)] transition-opacity duration-300 z-[99999]"
      role="status"
      aria-label="Loading page"
    >
      <div class="w-64 flex flex-col items-center gap-3">
        <div class="w-full flex justify-between font-mono text-[11px] text-[var(--color-chalk-white)] tracking-widest">
          <span class="text-[var(--color-red-blast)] font-bold">LOADING</span>
          <span id="loader-percent-counter" class="font-bold">0%</span>
        </div>
        <div class="w-full h-1 bg-[var(--color-steel-black)] relative overflow-hidden">
          <div
            id="loader-progress-bar"
            class="h-full bg-[var(--color-red-blast)] w-0 transition-all duration-100 ease-out"
          ></div>
        </div>
      </div>
    </div>

    <!-- Ambient Procedural Background Path (z-[3], behind content z-[5]) -->
    <BackgroundProceduralArrows />

    <div class="relative z-[5]">
      <slot />
    </div>

    <IndustrialLocatorCursor />
    <FullpageSnap />
    <SmoothScroll />
    <Scripts />
  </body>
</html>